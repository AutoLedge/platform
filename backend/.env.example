# Copy to .env and fill in. Never commit .env or real values.

# Deployment environment name: development or production
ENVIRONMENT=development

# Debug behaviour (true / false). Must be false in production.
DEBUG=true

# Postgres connection string from Supabase (Project Settings → Database)
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres

# Fernet key that encrypts Plaid access tokens in the database.
# Generate one per environment:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing it means every bank must be re-linked: keep it in a password manager.
PLAID_TOKEN_ENCRYPTION_KEY=<generated-fernet-key>
