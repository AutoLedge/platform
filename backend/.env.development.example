# Copy to .env.development and fill in. Never commit real values.
# Loaded by `uv run dev` (and by alembic unless APP_ENV is set).

ENVIRONMENT=development
DEBUG=true

# Supabase → Connect → Session pooler (port 5432). URL-encode special
# characters in the password.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase → Project Settings → API → Project URL (same as the frontend's VITE_SUPABASE_URL)
SUPABASE_URL=https://<project-ref>.supabase.co

# Optional in development; defaults to the Vite dev server.
# CORS_ORIGINS=http://localhost:5173

# Fernet key that encrypts Plaid access tokens. One per environment:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing it means every bank must be re-linked: keep it in a password manager.
PLAID_TOKEN_ENCRYPTION_KEY=<generated-fernet-key>

# Plaid Dashboard → Keys. Development uses the Sandbox secret; production the Production secret.
PLAID_CLIENT_ID=<client-id>
PLAID_SECRET=<secret>
# Countries offered in Plaid Link.
# PLAID_COUNTRY_CODES=CA,US
# Plaid webhooks (N16). Leave unset in day-to-day development; https only.
# PLAID_WEBHOOK_URL=https://<public-host>/plaid/webhook
