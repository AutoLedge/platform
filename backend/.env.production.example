# Reference for the production host's environment variables (preferred), or
# copy to .env.production on the server. Never commit real values.
# Loaded by `uv run prod`.

ENVIRONMENT=production
DEBUG=false

DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co

# Required in production: the deployed frontend URL(s), comma-separated. No localhost.
CORS_ORIGINS=https://<your-frontend-domain>

# A DIFFERENT key from development.
PLAID_TOKEN_ENCRYPTION_KEY=<generated-fernet-key>

# Plaid Dashboard → Keys. Development uses the Sandbox secret; production the Production secret.
PLAID_CLIENT_ID=<client-id>
PLAID_SECRET=<secret>
# Countries offered in Plaid Link.
# PLAID_COUNTRY_CODES=CA,US
# Plaid webhooks (N16). Leave unset in day-to-day development; https only.
# PLAID_WEBHOOK_URL=https://<public-host>/plaid/webhook

# Port to listen on; most hosts set this for you.
# PORT=8000
